# 仿真镜像: Icarus Verilog + Verilator + Verible + Surfer
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

# 基础依赖
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential ca-certificates curl git make python3 python3-pip \
    autoconf flex bison gperf \
    && rm -rf /var/lib/apt/lists/*

# Icarus Verilog (iverilog + vvp)
RUN apt-get update && apt-get install -y --no-install-recommends \
    iverilog \
    && rm -rf /var/lib/apt/lists/*

# Verilator (从源码编译以获得最新版本)
RUN apt-get update && apt-get install -y --no-install-recommends \
    perl python3 libfl-dev help2man ccache \
    && rm -rf /var/lib/apt/lists/*
RUN git clone --depth 1 https://github.com/verilator/verilator.git /opt/verilator \
    && cd /opt/verilator \
    && autoconf && ./configure && make -j$(nproc) && make install \
    && rm -rf /opt/verilator

# Verible (SystemVerilog linter)
RUN curl -L -o /tmp/verible.tar.gz \
    https://github.com/chipsalliance/verible/releases/latest/download/verible-bin-Ubuntu-24.04-x86_64.tar.gz \
    && tar -xzf /tmp/verible.tar.gz -C /opt \
    && ln -s /opt/verible-*/bin/* /usr/local/bin/ \
    && rm /tmp/verible.tar.gz

# Surfer (waveform viewer, WASM 模式由前端使用，这里安装 CLI 用于后端导出)
RUN curl -L -o /usr/local/bin/surfer \
    https://github.com/surfer-project/surfer/releases/latest/download/surfer-x86_64-unknown-linux-gnu \
    && chmod +x /usr/local/bin/surfer

# Python 依赖 (VCD/FST 解析)
RUN pip3 install --break-system-packages vcdvcd pyvcd fstpy

# 验证安装
RUN iverilog -V && verilator --version && verible-verilog-lint --version && surfer --version

WORKDIR /workspace
CMD ["/bin/bash"]
