# iflow-lab 后端容器 (FastAPI)
# 说明: EDA 工具链 (iEDA/OpenROAD/yosys/iverilog/... 与 PDK 数据) 在宿主机上,
#       容器通过挂载访问 — 见 docker-compose.yml 与 README.md 的「宿主机 EDA 模式」。
FROM python:3.10-slim

WORKDIR /app

# 国内镜像加速 (阿里云 pip 镜像)
RUN pip config set global.index-url https://mirrors.aliyun.com/pypi/simple/ && \
    pip install --no-cache-dir \
        fastapi==0.139.0 \
        uvicorn==0.50.0 \
        pydantic==2.12.5 \
        PyJWT==2.13.0 \
        requests==2.34.2 \
        pyyaml \
        jinja2 \
        matplotlib \
        numpy

COPY server/ ./server/
COPY adapter/ ./adapter/

EXPOSE 8000
CMD ["uvicorn", "server.api:app", "--host", "0.0.0.0", "--port", "8000"]
